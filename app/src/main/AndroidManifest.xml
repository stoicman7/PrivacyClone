<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access is required by the virtual-app engine for apps the user chooses to clone.
         PrivacyClone itself does not upload diagnostics or use analytics. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".PrivacyCloneApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_privacyclone"
        android:roundIcon="@drawable/ic_privacyclone"
        android:label="PrivacyClone"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".PrivacyCloneActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


    </application>
</manifest>
